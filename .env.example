# Скопируй в .env и заполни реальными значениями

# --- Тестируемый стенд ---
# Адрес тестируемого бэкенда (пусто = встроенный мок)
# BASE_URL=http://127.0.0.1:3005

# Логин/пароль директора (админа) тестируемого бэкенда
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# --- Верификация клиента (OTP) ---
# Приоритет источников кода, сверху вниз:
#   1. debugCode из ответа POST /api/clients/register — работает автоматически,
#      если бэкенд запущен с DEBUG=true (дев/тест-стенды). Ничего настраивать не нужно.
#   2. VERIFICATION_CODE — универсальный код стенда, если стенд его поддерживает.
#   3. Фиксированный код тестового номера (см. USE_TEST_PHONE).
#   4. Ручной ввод оператора в UI — если ничего из перечисленного нет.
# VERIFICATION_CODE=1234

# Закрепить один номер за фикстурой клиента вместо генерации нового.
# Изоляция прогонов теряется, зато идентичность стабильна.
# Внимание: бэкенд не отдаёт второй код на тот же номер чаще раза в 60 сек.
# FIXTURE_CLIENT_PHONE=+79991234567

# Использовать зашитый в бэкенд тестовый номер +79999999999 с кодом 9999.
# Работает только при DEBUG=true на бэкенде.
# USE_TEST_PHONE=false

# --- Фикстуры ---
# Город тестовых ресторанов и адресов клиента. Бэкенд геокодит его и принимает
# только города из справочника платформы (города существующих точек +
# supportedCities активного тарифа Locali). Для доставки Locali город обязан
# быть в supportedCities тарифа — иначе заказ отклонится.
# FIXTURE_CITY=Москва

# Координаты внутри FIXTURE_CITY: по ним создаётся точка и адрес клиента.
# Доставка считается по расстоянию, поэтому они должны совпадать с городом.
# FIXTURE_LATITUDE=55.7649
# FIXTURE_LONGITUDE=37.6055

# Группа курьеров для тестовых курьеров. Бэкенд пишет deliveryType напрямую в
# внешний ключ group_id, поэтому принимается только UUID существующей группы
# (список: GET /api/admin/groups). Пусто = курьер создаётся без группы —
# бэкенд это принимает, и стенду не нужны предварительные данные.
# FIXTURE_COURIER_GROUP_ID=

# --- Диагностика ---
# Печатать каждый HTTP-запрос/ответ в лог (пароли и токены маскируются).
# HTTP_DEBUG=false

# Каталог персистентных данных (стенды, токены, сценарии)
# DATA_DIR=/app/data

# --- Готовые токены ролей (обходят регистрацию/SMS) ---
# CLIENT_TOKEN=
# REST_TOKEN=
# COURIER_TOKEN=
# ADMIN_TOKEN=

# --- Оповещения о падениях ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Пример: локальный стенд с тарифом Locali на Грозный ---
# BASE_URL=http://127.0.0.1:3005
# FIXTURE_CITY=Грозный
# FIXTURE_LATITUDE=43.3169
# FIXTURE_LONGITUDE=45.6981
